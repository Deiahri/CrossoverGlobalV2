# Frontend (Next.js). Values live in .env.local — see studio/.env.example for the Studio.

# --- Sanity (public) --------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=gx5eh4lv
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-27

# --- Sanity (secret) --------------------------------------------------------
# Shared secret on the GROQ webhook at sanity.io/manage -> API -> Webhooks.
# Generate with: node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
SANITY_REVALIDATE_SECRET=

# Editor token, used ONLY by scripts/migrate-strapi-to-sanity.mjs.
# Not needed at runtime — do not ship it to the host.
SANITY_API_WRITE_TOKEN=

# The retired Strapi vars (NEXT_PUBLIC_STRAPI_URL, STRAPI_API_TOKEN) live in
# .env only. They are needed solely to re-run scripts/backup-strapi.mjs or
# `npm run migrate -- --live`, and can go once Strapi Cloud is shut down.
